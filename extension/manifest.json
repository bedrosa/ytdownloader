{
  "manifest_version": 3,
  "name": "YouTube Local · Descargar vídeo",
  "version": "2.1.5",
  "minimum_chrome_version": "116",
  "description": "Descarga desde el popup con la calidad que elijas. Todo se procesa dentro del navegador",
  "permissions": ["activeTab", "downloads", "storage", "offscreen", "scripting", "webRequest", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://*.youtube.com/*", "https://*.googlevideo.com/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://youtube.com/*"], "js": ["capture.js"], "run_at": "document_start", "world": "MAIN"}],
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "action": {"default_title": "Descargar el vídeo de YouTube", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}},
  "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}
}
